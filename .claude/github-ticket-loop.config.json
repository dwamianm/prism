{
  "baseBranch": "main",
  "includeLabels": [
    "audit-2026-09",
    "organized-memory"
  ],
  "excludeLabels": [
    "epic",
    "question",
    "wontfix",
    "duplicate",
    "needs-human",
    "blocked"
  ],
  "assignedOnly": false,
  "testCommand": "uv run pytest -q",
  "intervalMinutes": 15,
  "maxIterations": 40,
  "maxParallel": 1,
  "serialPaths": [
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "src/prme/config.py",
    "documentation/configuration.md",
    "data/**"
  ]
}
